# ローカル開発用の既定値。`cp .env.example .env` でそのまま動く。
# 本番 (Neon) に繋ぐ場合は DATABASE_URL を Neon の接続文字列に差し替える。
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bkmk"
BETTER_AUTH_SECRET="local-development-secret-at-least-32-characters-long"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:5173,http://localhost:5174"
# 認証メールを使う場合は、Resend API キーと確認済みドメインの送信元を設定する。
RESEND_API_KEY=""
EMAIL_FROM_ADDRESS=""
EMAIL_FROM_NAME="bkmk"
LOG_LEVEL="debug"
