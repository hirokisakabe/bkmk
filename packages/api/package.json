    "@hono/zod-validator": "^0.7.6",
    "better-auth": "^1.6.11",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.21",
    "hono-pino": "^0.10.3",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.5",
    "@types/node": "^22.15.18",
    "@types/pg": "^8.11.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.4",
    "vitest": "^4.1.4"
  }
